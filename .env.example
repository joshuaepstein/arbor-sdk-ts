# Copy to .env and fill in your sandbox details from the Arbor Developers Portal.
# .env is gitignored, so credentials stay out of the repo.

# Sandbox API host. A trailing /rest-v2 is fine.
ARBOR_BASE_URL=https://your-sandbox.uk.arbor.sc

# API user credentials for the sandbox.
ARBOR_USER=
ARBOR_PASSWORD=

# Optional: your application ID (sent as the x-mis-application-id header).
ARBOR_APPLICATION_ID=
